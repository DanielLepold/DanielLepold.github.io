---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import LogoStrip from '../components/LogoStrip.astro';
import { site, arc, focus, work, experience, education, toolbox, spoken } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<Base>
  <Hero />

  <!-- 01 ABOUT -->
  <section id="about" class="section">
    <div class="wrap">
      <SectionHead num="01" label="About">From finite elements <em>to production software</em></SectionHead>

      <div class="about">
        <div class="about-text">
          <p class="reveal">
            I trained as a structural engineer at the Budapest University of Technology and Economics.
            My MSc in <strong>Computational Structural Engineering</strong>, taught in English, was all about
            numerical methods and non-linear finite element analysis, and my thesis was already biomechanics:
            a finite element model of impacts on the human chest. I spent the first years of my career
            running automotive and industrial simulations and scripting the workflows around them.
          </p>
          <p class="reveal">
            The scripting turned into software. I wrote <strong>C++ for a finite element application</strong>
            used by structural engineers, then backend services in C# and Python, then
            <strong>cloud-native BIM microservices</strong> in .NET and F# on Kubernetes. Today I build AEC
            software end to end: plugins for Revit, Grasshopper, SketchUp, QGIS and ArcGIS, the Python,
            .NET and Rust SDKs underneath them, and the APIs behind those.
          </p>
          <p class="reveal">
            Alongside the engineering I earned a postgraduate degree in <strong>Data Science</strong>, and
            I'm now doing an MSc in <strong>Sport Performance Analytics</strong>, using computer vision to
            measure athletes from video. Across all of it the job is the same: take a physical problem,
            model it carefully, and ship software people can trust.
          </p>
        </div>

        <aside class="about-side reveal" style="--d:.1s">
          <p class="mono muted side-label">What drives me</p>
          <p class="side-quote display">
            Making the places we live more sustainable and liveable, and understanding the human
            body from data well enough to help athletes perform better and stay injury-free.
          </p>
          <ul class="side-list">
            {spoken.map((s) => (
              <li><span>{s.lang}</span><span class="muted">{s.level}</span></li>
            ))}
          </ul>
        </aside>
      </div>

      <ol class="arc reveal" aria-label="Career arc">
        {arc.map((a) => (
          <li>
            <span class="arc-year mono">{a.year}</span>
            <span class="arc-dot" aria-hidden="true"></span>
            <span class="arc-label">{a.label}</span>
          </li>
        ))}
      </ol>

      <LogoStrip />
    </div>
  </section>

  <!-- 02 FOCUS -->
  <section id="focus" class="section">
    <div class="wrap">
      <SectionHead num="02" label="What I do">Four fields I <em>work across</em></SectionHead>
      <div class="focus">
        {focus.map((f, i) => (
          <article class="focus-item reveal" style={`--d:${i * 0.06}s`}>
            <span class="mono focus-num">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <ul class="chips">{f.tags.map((t) => <li class="chip">{t}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 WORK -->
  <section id="work" class="section">
    <div class="wrap">
      <SectionHead num="03" label="Selected work">Shipped <em>industry products</em></SectionHead>
      <div class="work">
        {work.map((w, i) => (
          <article class="work-item reveal">
            <div class="work-meta">
              <span class="mono work-num">{String(i + 1).padStart(2, '0')}</span>
              <p class="work-org">{w.org}</p>
              <p class="mono muted">{w.period}</p>
            </div>
            <div class="work-main">
              <h3 class="work-title">{w.title}</h3>
              <p class="work-body">{w.body}</p>
              {w.points.length > 0 && (
                <ul class="work-points">{w.points.map((pt) => <li>{pt}</li>)}</ul>
              )}
              <ul class="chips">{w.tags.map((t) => <li class="chip">{t}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 PROJECTS -->
  <section id="projects" class="section">
    <div class="wrap">
      <SectionHead num="04" label="Research & projects">Problems I find <em>worth measuring</em></SectionHead>

      <div class="features">
        {featured.map((p, i) => <ProjectCard project={p} variant="feature" index={i} />)}
      </div>

      <div class="grid3">
        {rest.map((p, i) => <ProjectCard project={p} index={featured.length + i} />)}
      </div>
    </div>
  </section>

  <!-- 05 EXPERIENCE -->
  <section id="experience" class="section">
    <div class="wrap">
      <SectionHead num="05" label="Experience">Three areas of <em>my profession</em></SectionHead>
      <div class="timeline">
        {experience.map((era) => (
          <div class="era">
            <p class="era-name mono reveal">{era.era}</p>
            <div class="era-roles">
              {era.roles.map((r) => (
                <article class="role reveal">
                  <span class="role-dot" aria-hidden="true"></span>
                  <div class="role-head">
                    <h3>{r.role} <span class="muted">·</span> <span class="role-co">{r.company}</span></h3>
                    <p class="mono muted">{r.period}{r.place && ` · ${r.place}`}</p>
                  </div>
                  <p class="role-body">{r.body}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 EDUCATION -->
  <section id="education" class="section">
    <div class="wrap">
      <SectionHead num="06" label="Education">Engineering roots, <em>data-driven branches</em></SectionHead>
      <ol class="edu">
        {education.map((e) => (
          <li class="edu-item reveal">
            <p class="mono muted edu-period">{e.period}</p>
            <div class="edu-main">
              <h3>{e.degree}</h3>
              <p class="edu-school">{e.school}</p>
              {e.notes.length > 0 && <ul class="edu-notes">{e.notes.map((n) => <li>{n}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 TOOLBOX -->
  <section id="toolbox" class="section">
    <div class="wrap">
      <SectionHead num="07" label="Toolbox">The tools <em>behind the work</em></SectionHead>
      <div class="tools">
        {toolbox.map((g) => (
          <div class="tool-row reveal">
            <p class="mono tool-name">{g.group}</p>
            <ul class="chips">{g.items.map((t) => <li class="chip">{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 08 CONTACT -->
  <section id="contact" class="section contact">
    <div class="wrap">
      <p class="section-label mono reveal"><b>08</b> Contact</p>
      <h2 class="contact-title display reveal" style="--d:.06s">
        Building something for the <em>built environment</em>, or measuring <em>human motion</em>?
      </h2>
      <p class="contact-lede reveal" style="--d:.12s">
        I'm happy to talk about AEC and geospatial software, SDK and backend work, or computer vision for
        sport science.
      </p>
      <a class="contact-mail reveal" style="--d:.18s" href={`mailto:${site.email}`}>
        {site.email}
        <Icon name="arrow-up-right" />
      </a>
      <ul class="contact-links reveal" style="--d:.24s">
        <li><a href={site.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>
        <li><a href={site.links.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a></li>
        <li><a href={site.links.medium} target="_blank" rel="noopener"><Icon name="medium" /> Medium</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* About */
  .about {
    display: grid;
    gap: 48px;
  }
  .about-text {
    display: grid;
    gap: 22px;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 64ch;
  }
  .about-text strong {
    color: var(--ink);
    font-weight: 600;
  }
  .about-side {
    border-top: 1px solid var(--ink);
    padding-top: 20px;
    align-self: start;
  }
  .side-label {
    font-size: 11px;
  }
  .side-quote {
    font-size: 20px;
    line-height: 1.3;
    margin: 12px 0 28px;
  }
  .side-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14.5px;
  }
  .side-list li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .about-text {
      grid-column: 2;
      grid-row: 1;
    }
    .about-side {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .arc {
    list-style: none;
    padding: 0;
    margin: clamp(56px, 8vw, 88px) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
    position: relative;
  }
  .arc li {
    display: grid;
    gap: 8px;
    position: relative;
  }
  .arc-year {
    color: var(--muted);
    font-size: 11px;
  }
  .arc-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    background: var(--bg);
    position: relative;
    z-index: 1;
  }
  .arc li:last-child .arc-dot {
    background: var(--accent);
  }
  .arc-label {
    font-size: 14.5px;
    line-height: 1.35;
    font-weight: 500;
  }
  @media (min-width: 760px) {
    .arc {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .arc::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 30px;
      height: 1px;
      background: linear-gradient(90deg, var(--line-strong), var(--accent));
    }
  }

  /* Focus */
  .focus {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .focus-item {
    background: var(--surface);
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 0.3s;
  }
  .focus-item:hover {
    background: var(--surface-2);
  }
  .focus-num {
    color: var(--accent);
    font-size: 11px;
  }
  .focus-item h3 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    font-size: 21px;
    line-height: 1.2;
  }
  .focus-item p {
    color: var(--ink-2);
    font-size: 15.5px;
    flex: 1;
  }
  @media (min-width: 720px) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .focus {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Work */
  .work {
    border-top: 1px solid var(--line);
  }
  .work-item {
    display: grid;
    gap: 18px;
    padding-block: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--line);
  }
  .work-meta {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .work-num {
    color: var(--accent);
    font-size: 11px;
  }
  .work-org {
    font-weight: 600;
    font-size: 16px;
  }
  .work-meta .mono {
    font-size: 11px;
  }
  .work-main {
    display: grid;
    gap: 16px;
    max-width: 72ch;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.2;
  }
  .work-body {
    color: var(--ink-2);
  }
  .work-points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .work-points li {
    position: relative;
    padding-left: 22px;
  }
  .work-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }
  @media (min-width: 900px) {
    .work-item {
      grid-template-columns: 260px minmax(0, 1fr);
    }
  }

  /* Projects */
  .features {
    display: grid;
    gap: 24px;
  }
  .grid3 {
    display: grid;
    gap: 24px;
    margin-top: 24px;
  }
  @media (min-width: 720px) {
    .grid3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid3 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Experience */
  .timeline {
    display: grid;
    gap: 48px;
  }
  .era {
    display: grid;
    gap: 16px;
  }
  .era-name {
    color: var(--accent);
    font-size: 11px;
  }
  .era-roles {
    border-left: 1px solid var(--line-strong);
    display: grid;
    gap: 36px;
    padding-left: 28px;
  }
  .role {
    position: relative;
    display: grid;
    gap: 10px;
    max-width: 76ch;
  }
  .role-dot {
    position: absolute;
    left: -33px;
    top: 9px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--accent);
  }
  .role-head h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .role-co {
    font-weight: 400;
    color: var(--ink-2);
  }
  .role-head .mono {
    font-size: 11px;
    margin-top: 6px;
  }
  .role-body {
    color: var(--ink-2);
    font-size: 15.5px;
  }
  @media (min-width: 900px) {
    .era {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .era-name {
      padding-top: 6px;
    }
  }

  /* Education */
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .edu-item {
    display: grid;
    gap: 8px;
    padding-block: 26px;
    border-bottom: 1px solid var(--line);
  }
  .edu-period {
    font-size: 11px;
    padding-top: 4px;
  }
  .edu-main {
    display: grid;
    gap: 6px;
  }
  .edu-main h3 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    font-size: 20px;
    line-height: 1.3;
  }
  .edu-school {
    color: var(--ink-2);
    font-size: 15.5px;
  }
  .edu-notes {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    font-size: 14.5px;
    color: var(--muted);
    display: grid;
    gap: 4px;
  }

  /* Toolbox */
  .tools {
    border-top: 1px solid var(--line);
  }
  .tool-row {
    display: grid;
    gap: 12px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .tool-name {
    font-size: 11px;
    color: var(--accent);
    padding-top: 5px;
  }
  @media (min-width: 900px) {
    .edu-item,
    .tool-row {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 0 48px;
    }
  }

  /* Contact */
  .contact {
    padding-block: clamp(96px, 14vw, 180px);
  }
  .contact-title {
    font-size: clamp(32px, 4.6vw, 60px);
    line-height: 1.02;
    max-width: 18ch;
    margin-top: 24px;
  }
  .contact-lede {
    margin-top: 28px;
    max-width: 48ch;
    font-size: 18px;
    color: var(--ink-2);
  }
  .contact-mail {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 44px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    font-size: clamp(20px, 3vw, 36px);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 6px;
    transition: color 0.2s, border-color 0.2s;
    overflow-wrap: anywhere;
  }
  .contact-mail :global(svg) {
    width: 0.6em;
    height: 0.6em;
    flex: none;
    transition: transform 0.3s;
  }
  .contact-mail:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .contact-mail:hover :global(svg) {
    transform: translate(4px, -4px);
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
  }
  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 15px;
    transition: border-color 0.2s, color 0.2s;
  }
  .contact-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .contact-links :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
